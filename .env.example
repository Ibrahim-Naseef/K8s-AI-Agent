# ===== LLM: pick ONE free provider block =====
# A) OpenRouter free router (one key, auto-picks a free model that supports tool calling)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-xxxxxxxx
MODEL=openrouter/free
# MODEL_FALLBACKS=            # optional, comma-separated model ids (OpenRouter only)

# B) Groq free tier  (verify the current model name in Groq's docs)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_xxxxxxxx
# MODEL=llama-3.3-70b-versatile

# C) Google Gemini free tier, OpenAI-compatible endpoint (verify current model name)
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=xxxxxxxx
# MODEL=gemini-2.5-flash

# ===== App =====
# Long random string. The dashboard asks for it. Generate: openssl rand -hex 32
APP_TOKEN=change-me
# Namespaces the agent may inspect (comma separated). Everything else is refused.
ALLOWED_NAMESPACES=default,demo
MAX_STEPS=8
LOG_TAIL_LINES=100
DB_PATH=data/investigations.db
